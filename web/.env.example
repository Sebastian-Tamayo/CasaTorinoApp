# web / TPV — Vercel Environment Variables (nunca subir valores reales)

TPV_PIN=
# PIN del botón «Editar Carta» en el TPV (por defecto 2908)
CARTA_EDIT_PIN=2908
TPV_SYNC_KEY=
# Supabase (ops_kv + fotos Storage menu_images)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Obligatorio para subir fotos al bucket menu_images (solo servidor; nunca en el front)
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Informes semanal/mensual por email (Resend — plan gratis)
# Tras cerrar caja el domingo + backup lunes 08:00 Madrid; mensual día 1.
RESEND_API_KEY=
REPORT_EMAIL_TO=cafebartorino@gmail.com
# Dominio verificado en Resend, o usa onboarding@resend.dev solo para pruebas
REPORT_EMAIL_FROM=Casa Torino <onboarding@resend.dev>
# Opcional: mismo valor que TPV_SYNC_KEY si no defines CRON_SECRET
CRON_SECRET=
