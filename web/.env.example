# web / TPV — Vercel Environment Variables (nunca subir valores reales)

TPV_EDGE_CONFIG_ID=
TPV_PIN=
# PIN del botón «Editar Carta» en el TPV (por defecto 2908)
CARTA_EDIT_PIN=2908
TPV_SYNC_KEY=
# Supabase (ops_kv + fotos de carta)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Opcional pero recomendado: secret/service role SOLO en Vercel (nunca en el front).
# Con esto las fotos van al bucket menu_images. Sin él, van a ops_kv (también gratis).
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
TPV_TEAM_ID=
TPV_VERCEL_TOKEN=
