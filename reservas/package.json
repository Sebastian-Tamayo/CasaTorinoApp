{
  "name": "casa-torino-reservas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:local\" \"vite\"",
    "local": "node server/local-server.mjs",
    "build": "tsc -b && vite build",
    "start": "npm run build && npm run local",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy:vercel": "vercel --prod"
  },
  "dependencies": {
    "@netlify/blobs": "^11.0.3",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vercel": "^59.16.0",
    "vite": "^8.3.0"
  }
}
