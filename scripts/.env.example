# Copiar a scripts/.env en el PC del restaurante. No subir .env a Git.

# Opcional: el TPV puede pedir el disparo a GitHub si el navegador no llega (CORS).
# Classic PAT o fine-grained con permiso para repository_dispatch.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=Sebastian-Tamayo/CasaTorinoApp

STORIES_PORT=3001

# Estos van en GitHub Secrets (no en el PC), los usa el workflow:
# IG_USER_ID
# IG_ACCESS_TOKEN
# TIKTOK_ACCESS_TOKEN
# TIKTOK_PRIVACY=SELF_ONLY
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
