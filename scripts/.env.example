# Copiar a scripts/.env en el PC del restaurante. No subir .env a Git.

# Token de GitHub para repository_dispatch. Va en Supabase (private.menu_story_secrets),
# no en el navegador. La pantalla es web/historias.html.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=Sebastian-Tamayo/CasaTorinoApp

STORIES_PORT=3001

# Estos van en GitHub Secrets (no en el PC), los usa el workflow:
# IG_USER_ID
# IG_ACCESS_TOKEN
# TIKTOK_ACCESS_TOKEN
# TIKTOK_PRIVACY=SELF_ONLY
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
