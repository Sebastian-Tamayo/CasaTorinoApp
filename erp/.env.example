# Supabase — Casa Torino Back-office
# Copia este archivo a .env.local y rellena los valores

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Recomendado en servidor ERP: lee ops_kv (jornada/cierres) sin pasar por APIs Vercel
SUPABASE_SERVICE_ROLE_KEY=

# PIN de acceso al ERP (administración completa). Distinto del TPV/cocina/reservas.
# Solo en Vercel / .env.local — nunca hardcodear el valor real en el repo.
ERP_PIN=

# Nota: los correos de informe semanal/mensual se envían desde el proyecto web
# (Vercel casa-torino-web): RESEND_API_KEY + REPORT_EMAIL_TO=cafebartorino@gmail.com
